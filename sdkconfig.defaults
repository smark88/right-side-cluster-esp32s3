CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_MEMCPY_MEMSET_STD=y
CONFIG_LV_USE_USER_DATA=y
CONFIG_LV_USE_CHART=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y

CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_DATA_CACHE_LINE_SIZE=64

CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_MHZ=240
# ---- 7in combined dash: frame-rate settings --------------------------------
# -O2 rather than -Og: LVGL's software renderer is the frame budget on the S3.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# 1 ms tick. At 100 Hz every sub-10ms delay rounded to 0 or 10 ms, so frame
# pacing snapped to 10 ms steps.
CONFIG_FREERTOS_HZ=1000
CONFIG_LV_DISP_DEF_REFR_PERIOD=16
# LVGL's hot draw paths in IRAM instead of executing from flash.
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_44=y
# Gauge page: fuel / ethanol values (24) and tile values (40).
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_40=y
# ui_font_rpm_96 (shared with the round gauges) is RLE-compressed; without
# this LVGL silently draws nothing for it -- the MPH number was invisible.
CONFIG_LV_USE_FONT_COMPRESSED=y

# ---- 7in combined dash: cleanup ---------------------------------------------
# Leftovers from Waveshare's example project. Bluetooth is never used and
# LVGL's demo apps only cost build time and flash. The FPS/CPU overlay sits on
# top of the odometer: turn it back on in menuconfig to measure.
# CONFIG_BT_ENABLED is not set
# CONFIG_LV_USE_DEMO_WIDGETS is not set
# CONFIG_LV_USE_DEMO_KEYPAD_AND_ENCODER is not set
# CONFIG_LV_USE_DEMO_BENCHMARK is not set
# CONFIG_LV_USE_DEMO_STRESS is not set
# CONFIG_LV_USE_DEMO_MUSIC is not set
# CONFIG_LV_USE_PERF_MONITOR is not set
